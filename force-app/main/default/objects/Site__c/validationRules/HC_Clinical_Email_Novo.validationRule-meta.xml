<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>HC_Clinical_Email_Novo</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 Account__r.Name = &quot;Novo Nordisk Clinical&quot;,
 OR(ISBLANK(Site_Primary_Email__c),ISNULL(Site_Primary_Email__c))
)</errorConditionFormula>
    <errorDisplayField>Site_Primary_Email__c</errorDisplayField>
    <errorMessage>Email is a required field for Novo Nordisk Clinical.  Please enter a value for the field</errorMessage>
</ValidationRule>

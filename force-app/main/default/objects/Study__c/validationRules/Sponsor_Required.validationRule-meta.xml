<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sponsor_Required</fullName>
    <active>false</active>
    <errorConditionFormula>OR(ISNULL(Sponsor__c), ISBLANK(Sponsor__c))</errorConditionFormula>
    <errorDisplayField>Sponsor__c</errorDisplayField>
    <errorMessage>The Sponsor field cannot be left blank for Novartis Organization, Please select valid Sponsor</errorMessage>
</ValidationRule>
